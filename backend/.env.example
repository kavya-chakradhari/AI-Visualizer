PORT=4000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
CORS_ORIGIN="http://localhost:5173"

# ── AI layer ──────────────────────────────────────────────────────────────
# Selects the LLMProvider implementation. "mock" (default) needs no API key
# and is what tests/dev use out of the box.
#   AI_PROVIDER=anthropic  →  uses Claude (ANTHROPIC_API_KEY required)
#   AI_PROVIDER=gemini     →  uses Google Gemini (GEMINI_API_KEY required)
#   AI_PROVIDER=groq       →  uses Groq (GROQ_API_KEY required)
AI_PROVIDER=mock

# Backend-only secrets. NEVER prefix these with VITE_ / NEXT_PUBLIC_ / etc.,
# never send them to the frontend, and never log them — each provider reads
# its key once at construction and uses it only in a request header.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Auth ──────────────────────────────────────────────────────────────────
# Off by default: every request is attributed to a fixed dev user, no token
# required. Set AUTH_ENABLED=true (and a real API_AUTH_TOKEN) before this API
# is reachable from anywhere other than your own machine — see
# src/middleware/auth.ts for exactly what turning it on changes.
AUTH_ENABLED=false
API_AUTH_TOKEN=

# ── Upload / parsing limits ───────────────────────────────────────────────
# All optional — sane defaults are baked in; override only if you need to.
# MAX_CONCURRENT_UPLOADS=3
# MAX_DATASET_ROWS=200000
# MAX_XLSX_DECOMPRESSED_BYTES=209715200
